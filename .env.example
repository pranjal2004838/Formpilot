# ============================================================
# FormPilot — Environment Variables
# Copy this file to .env and fill in your values.
# Only GEMINI_API_KEY is REQUIRED; everything else is optional.
# ============================================================

# ── REQUIRED ─────────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── SERVER ────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO

# ── ORCHESTRATION PLATFORM ────────────────────────────────────
# Get from your orchestration platform settings
ORCHESTRATOR_API_KEY=
ORCHESTRATOR_PIPELINE_ID=
ORCHESTRATOR_BASE_URL=https://api.orchestrator.local

# Public URL of this deployed FormPilot API (used as orchestrator tool base_url)
FORMPILOT_API_URL=https://formpilot.up.railway.app
# Bearer token the orchestrator uses when calling /api/tools/* endpoints
FORMPILOT_API_KEY=

# ── PERSISTENCE / AUDIT ──────────────────────────────────────
# SQLite database for workflow history + audit trail
DATABASE_URL=sqlite:///./formpilot.db

# ── SLACK ─────────────────────────────────────────────────────
# Create Incoming Webhook at https://api.slack.com/apps
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
SLACK_CHANNEL=#formpilot-notifications

# ── SHAREPOINT / MICROSOFT GRAPH ──────────────────────────────
# App Registration: https://portal.azure.com → Azure AD → App registrations
# Required Graph permissions: Sites.ReadWrite.All, Files.ReadWrite.All
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_URL=https://contoso.sharepoint.com/sites/formpilot
SHAREPOINT_LIBRARY=FormPilot Documents
